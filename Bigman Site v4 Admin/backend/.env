# ═══════════════════════════════════════════════════════════════
# BIGMAN ACADEMIC SERVICES — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB Atlas ───────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb://bigman-prod:BEadmin2026ke@ac-ufg4ra9-shard-00-00.hf39qnx.mongodb.net:27017,ac-ufg4ra9-shard-00-01.hf39qnx.mongodb.net:27017,ac-ufg4ra9-shard-00-02.hf39qnx.mongodb.net:27017/?ssl=true&replicaSet=atlas-10ojlv-shard-0&authSource=admin&appName=bigman-prod

# ── JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Admin Seed ──────────────────────────────────────────────────
# Used by scripts/seed-admin.js to create the first admin account
ADMIN_EMAIL=lamuerte1243@gmail.com
ADMIN_PASSWORD=Shukridengedidaharsama12
ADMIN_NAME=Bigman Admin

# ── Email (Nodemailer) ──────────────────────────────────────────
# For Gmail: enable 2FA, then create an App Password
# For SendGrid: use smtp.sendgrid.net port 587, user=apikey, pass=your_api_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Bigman Academic Services <noreply@bigmanacademicservices.com>
ADMIN_NOTIFY_EMAIL=admin@bigmanacademicservices.com

# ── Frontend URL (used for CORS + email links) ──────────────────
# Netlify preview:  https://your-site.netlify.app
# Production:       https://bigmanacademicservices.com
FRONTEND_URL=http://localhost:3000

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
